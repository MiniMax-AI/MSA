#include "common/kernel/include/m3_decode_sm100_params.hpp"
#include "common/kernel/include/tvm_ffi_utils.hpp"

using tvm::ffi::Optional;

extern cudaError_t {{ func_name }}(const M3DecodeMegaKernelParams& p);

void M3DecodeMegaAttenVariantRun_{{ variant_name }}(
    ffi::TensorView q, ffi::TensorView k, ffi::TensorView v,
    ffi::TensorView kv_segment_lens, ffi::TensorView o,
    ffi::TensorView o_sf, double sm_scale, double scale_q,
    double scale_k, double scale_v, double o_scale,
    ffi::TensorView kv_indices, int64_t kv_page_stride,
    Optional<ffi::TensorView> maybe_kv_block_indexes,
    ffi::TensorView k_scale, ffi::TensorView v_scale,
    ffi::TensorView output_projection_weight,
    ffi::TensorView output_projection_weight_sf,
    ffi::TensorView output_projection_barrier, int64_t tp_unicast_ptr,
    int64_t tp_multicast_ptr, int64_t tp_rank,
    ffi::TensorView residual_in, ffi::TensorView attention_residual,
    ffi::TensorView post_attention_norm, ffi::TensorView rms_weight,
    Optional<ffi::TensorView> maybe_indexer_q,
    Optional<ffi::TensorView> maybe_indexer_k,
    Optional<ffi::TensorView> maybe_indexer_k_scale,
    Optional<ffi::TensorView> maybe_indexer_page_table,
    Optional<ffi::TensorView> maybe_attention_projection_input_norm_weight,
    Optional<ffi::TensorView> maybe_attention_projection_weight,
    Optional<ffi::TensorView> maybe_attention_projection_weight_sf,
    Optional<ffi::TensorView> maybe_attention_projection_workspace_data,
    Optional<ffi::TensorView> maybe_attention_projection_workspace_scale,
    Optional<ffi::TensorView> maybe_attention_projection_grid_epoch,
    Optional<ffi::TensorView> maybe_attention_projection_special_partial,
    Optional<ffi::TensorView> maybe_attention_projection_special_epochs,
    Optional<ffi::TensorView> maybe_attention_projection_positions,
    Optional<ffi::TensorView> maybe_attention_projection_slot_mapping,
    Optional<ffi::TensorView> maybe_attention_projection_q_norm_weight,
    Optional<ffi::TensorView> maybe_attention_projection_k_norm_weight,
    Optional<ffi::TensorView> maybe_attention_projection_qi_norm_weight,
    Optional<ffi::TensorView> maybe_attention_projection_ki_norm_weight,
    Optional<ffi::TensorView> maybe_attention_projection_cos_sin_cache,
    double attention_projection_input_norm_eps,
    double attention_projection_post_norm_eps,
    double attention_projection_ki_dequant_scale, double rms_eps, int64_t wait_timeout_ns,
    int64_t stream_ptr) {
  int const head_dim_qk = q.size(2);
  int const head_dim_vo = head_dim_qk;
  int const num_qo_heads = q.size(1);
  int const num_kv_heads = k.size(1);
  int* kv_block_indexes_ptr =
      maybe_kv_block_indexes.has_value()
          ? static_cast<int*>(maybe_kv_block_indexes.value().data_ptr())
          : nullptr;

  M3DecodeMegaKernelParams params{};
  params.q_ptr = q.data_ptr();
  params.k_ptr = k.data_ptr();
  params.v_ptr = v.data_ptr();
  params.kv_segment_lens_ptr = static_cast<int*>(kv_segment_lens.data_ptr());
  params.o_direct_ptr = o.data_ptr();
  params.o_sf_ptr = o_sf.data_ptr();
  params.sm_scale = sm_scale;
  params.scale_q = scale_q;
  params.scale_k = scale_k;
  params.scale_v = scale_v;
  params.o_scale = o_scale;
  params.num_qo_heads = num_qo_heads / 16;
  params.num_kv_heads = num_kv_heads;
  params.num_qo_heads_orig = num_qo_heads;
  params.head_dim_qk = head_dim_qk;
  params.head_dim_vo = head_dim_vo;
  params.q_stride_n = q.stride(0);
  params.q_stride_h = q.stride(1);
  params.k_stride_n = k.stride(0);
  params.k_stride_h = k.stride(1);
  params.v_stride_n = v.stride(0);
  params.v_stride_h = v.stride(1);
  params.batch_size = kv_segment_lens.size(0);
  params.total_qo_len = q.size(0) * 16;
  params.total_qo_len_orig = q.size(0);
  params.stream = reinterpret_cast<cudaStream_t>(stream_ptr);
  params.kv_indices_ptr = static_cast<int*>(kv_indices.data_ptr());
  params.kv_page_stride = static_cast<int>(kv_page_stride);
  params.total_page_num = k.size(0);
  params.kv_block_indexes_ptr = kv_block_indexes_ptr;
  params.kv_block_num = maybe_kv_block_indexes.has_value()
                            ? static_cast<int>(
                                  maybe_kv_block_indexes.value().size(2))
                            : 16;
  params.indexer_q_ptr = maybe_indexer_q.value().data_ptr();
  params.indexer_k_ptr = maybe_indexer_k.value().data_ptr();
  params.indexer_k_scale_ptr = maybe_indexer_k_scale.value().data_ptr();
  // Cache tensors are byte-element views, so stride(0) is the physical page stride in bytes.
  params.indexer_k_page_stride = maybe_indexer_k.value().stride(0);
  params.indexer_k_scale_page_stride = maybe_indexer_k_scale.value().stride(0);
  params.indexer_page_table_ptr = static_cast<int*>(
      maybe_indexer_page_table.value().data_ptr());

  params.attention_projection_input_norm_weight_ptr =
      maybe_attention_projection_input_norm_weight.value().data_ptr();
  params.attention_projection_w_ptr =
      maybe_attention_projection_weight.value().data_ptr();
  params.attention_projection_w_sf_ptr =
      maybe_attention_projection_weight_sf.value().data_ptr();
  params.attention_projection_workspace_data_ptr =
      maybe_attention_projection_workspace_data.value().data_ptr();
  params.attention_projection_workspace_scale_ptr =
      maybe_attention_projection_workspace_scale.value().data_ptr();
  params.attention_projection_grid_epoch_ptr =
      maybe_attention_projection_grid_epoch.value().data_ptr();
  params.attention_projection_special_partial_ptr =
      maybe_attention_projection_special_partial.value().data_ptr();
  params.attention_projection_special_epochs_ptr =
      maybe_attention_projection_special_epochs.value().data_ptr();
  params.attention_projection_positions_ptr =
      maybe_attention_projection_positions.value().data_ptr();
  params.attention_projection_slot_mapping_ptr =
      maybe_attention_projection_slot_mapping.value().data_ptr();
  params.attention_projection_q_norm_weight_ptr =
      maybe_attention_projection_q_norm_weight.value().data_ptr();
  params.attention_projection_k_norm_weight_ptr =
      maybe_attention_projection_k_norm_weight.value().data_ptr();
  params.attention_projection_qi_norm_weight_ptr =
      maybe_attention_projection_qi_norm_weight.value().data_ptr();
  params.attention_projection_ki_norm_weight_ptr =
      maybe_attention_projection_ki_norm_weight.value().data_ptr();
  params.attention_projection_cos_sin_cache_ptr =
      maybe_attention_projection_cos_sin_cache.value().data_ptr();
  params.attention_projection_input_norm_eps =
      static_cast<float>(attention_projection_input_norm_eps);
  params.attention_projection_post_norm_eps =
      static_cast<float>(attention_projection_post_norm_eps);
  params.attention_projection_k_dequant_scale = static_cast<float>(scale_k);
  params.attention_projection_v_dequant_scale = static_cast<float>(scale_v);
  params.attention_projection_ki_dequant_scale =
      static_cast<float>(attention_projection_ki_dequant_scale);

  params.k_scale_ptr = k_scale.data_ptr();
  params.v_scale_ptr = v_scale.data_ptr();
  params.k_scale_page_stride = k_scale.stride(0);
  params.v_scale_page_stride = v_scale.stride(0);
  params.output_projection_w_ptr = output_projection_weight.data_ptr();
  params.output_projection_w_sf_ptr = output_projection_weight_sf.data_ptr();
  params.output_projection_barrier_ptr = output_projection_barrier.data_ptr();
  params.tp_unicast_ptr = reinterpret_cast<void*>(tp_unicast_ptr);
  params.tp_multicast_ptr = reinterpret_cast<void*>(tp_multicast_ptr);
  params.tp_rank = static_cast<int>(tp_rank);
  params.residual_in_ptr = residual_in.data_ptr();
  params.residual_out_ptr = attention_residual.data_ptr();
  params.attention_residual_ptr = attention_residual.data_ptr();
  params.post_attention_norm_ptr = post_attention_norm.data_ptr();
  params.rms_weight_ptr = rms_weight.data_ptr();
  params.rms_eps = static_cast<float>(rms_eps);
  params.wait_timeout_ns = static_cast<uint64_t>(wait_timeout_ns);

  cudaError_t const status = {{ func_name }}(params);
  TVM_FFI_ICHECK_EQ(status, cudaSuccess)
      << "M3 Decode MegaAtten variant {{ variant_name }} failed: "
      << cudaGetErrorString(status);
}

TVM_FFI_DLL_EXPORT_TYPED_FUNC(
    run_{{ variant_name }}, M3DecodeMegaAttenVariantRun_{{ variant_name }});
